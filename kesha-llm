    busy, stop = [""], threading.Event()

    def work(question=None):
        try:
            busy[0] = "loading"
            if not ensure_server(key):
                if busy[0]:  # not cancelled by leaving the screen
                    msgs.append(["error", "Could not load the model. It may be too big for the free RAM."])
                return
