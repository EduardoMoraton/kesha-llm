def session(folder):
    """One project: chat (left) and files (right). Fn ←/→ switch the focus, Tab the screen, F1 shows help."""
    views = ("Files+Chat", "Models", "Runs")
    SPLIT, MODELS, RUNS = range(3)
    view, cwd, sel, jsel, msel, up, typed, flash, goto, focus = 0, folder, 0, 0, 0, 0, "", ("", 0), None, "chat"
    chat_file, busy, stop, last = folder / ".chat.json", [""], threading.Event(), [None, None]  # last: script, job
    warmed = [None]  # the server process whose prompt state already holds the Code examples
    try:
        history = json.loads(chat_file.read_text())
    except (OSError, ValueError):
        history = []
    have = usable(vision=False)
    tools_note(folder)

    def context():
        """Enabled notes in .context/: they are pasted into the prompt because the model cannot read files."""
        return [p for p in sorted((folder / ".context").glob("*")) if p.is_file() and p.suffix != ".off"]

    def work(file):
        try:
            if not ensure_server(have[0]):
                if busy[0]:
                    history.append({"role": "note", "content": "Could not load the model (too big for the RAM?)"})
                return
            state = f"{slug(have[0], 40)}-{CODE_ID}.bin"
            fresh = warmed[0] is not server  # this server process has not seen the examples yet
            if fresh and not slot("restore", state):
                history.append({"role": "note", "content": "First time with this model: about a minute"})
            busy[0] = "writing"
            notes = "\n".join(p.read_text(errors="replace")[:4000] for p in context())
            ran = ""
            if last[1] and last[1]["proc"].poll() not in (None, 0):  # a failed run: let the model see the error
                ran = f"Running {last[1]['name']} failed with:\n{''.join(last[1]['out'])[-200:].strip()}"
            msgs = [m for m in history if m["role"] != "note"][-5:]
            while msgs[0]["role"] != "user":  # chat templates want the first turn to be the user's
                msgs.pop(0)
            ask, reply = msgs[-1]["content"], {"role": "assistant", "content": ""}
            history.append(reply)
            for piece in stream(code_prompt(notes, msgs, ran, file), stop, max_tokens=300, temperature=0.1):
                reply["content"] += piece
                if reply["content"].count("```") >= 2:  # the script is complete; tiny models ramble after it
                    break
            if fresh and not (DATA / "slots" / state).exists():
                slot("save", state)
            warmed[0] = server
            for name, ext, body in extract_scripts(reply["content"])[:1]:
                path, n = folder / (name or slug(ask) + ext), 2
                if file:  # the request was about the selected script, so the answer is its new version even
                    path = file  # when the model renames it (tiny models do). The old version is kept.
                    (folder / ".history").mkdir(exist_ok=True)
                    shutil.copy2(path, folder / ".history" / path.name)
                    verb = "edited"
                else:     # a new script, named by the model: never overwrite an existing file
                    while path.exists():
                        path, n = folder / f"{Path(name or slug(ask)).stem}-{n}{ext}", n + 1
                    verb = "saved"
                path.write_text(strip_comments(body))
                last[0] = path  # the main loop moves the file selection to it
                history.append({"role": "note", "content": f"{verb} {path.name}  -  Ctrl+R runs it"})
        except (OSError, ValueError) as e:
            history.append({"role": "note", "content": f"error: {e}"})
        finally:
            busy[0] = ""
            del history[:-40]
            chat_file.write_text(json.dumps(history))

    def run(path):
        stop.set()
        busy[0] = ""
        stop_server()  # scripts get the RAM: the model is loaded again on the next message
        job = launch(path)
        if not job:
            return (f"{MAX_RUNNING} runs at once is the limit", time.time() + 2)
        last[1] = job
        console(job)
        return flash

    while True:
        files = sorted((p for p in cwd.iterdir() if p.name != ".chat.json"), key=lambda p: (p.is_file(), p.name))
        goto, last[0] = goto or last[0], None
        if goto in files:  # a file that was just created (by you or by Kesha) gets the selection
            sel = files.index(goto)
        goto = None
        sel, jsel = min(sel, max(0, len(files) - 1)), min(jsel, max(0, len(jobs) - 1))
        here = files[sel] if files else None
        for k, u in keys():
            low = u.lower()
            if k == pygame.K_F1:
                help_modal()
            elif k == pygame.K_TAB:
                view = (view + 1) % len(views)
            elif k == pygame.K_ESCAPE:
                if busy[0] == "writing":
                    stop.set()
                elif view == SPLIT and focus == "files" and cwd != folder:
                    cwd, sel = cwd.parent, 0
                else:
                    stop.set()
                    if busy[0]:
                        busy[0] = ""
                        stop_server()
                    return
            elif view == MODELS:  # pick the model this project talks to
                if have:
                    msel = (msel + step(k, u)) % len(have)
                    if k == pygame.K_RETURN:
                        save_config({**load_config(), "model": have[msel]})
                        have, msel = usable(vision=False), 0  # usable() puts the chosen one first
            elif view == RUNS:
                jsel = (jsel + step(k, u)) % max(1, len(jobs))
                if jobs and k == pygame.K_RETURN:
                    console(jobs[jsel])
                elif jobs and low == "k":
                    kill(jobs[jsel])
            elif k == pygame.K_LEFT:   # Fn ← focuses the chat, Fn → the files
                focus = "chat"
            elif k == pygame.K_RIGHT:
                focus = "files"
            elif focus == "files":  # right panel is a normal file menu: letters are commands, Fn arrows / F,X move
                sel = (sel + step(k, u)) % max(1, len(files))
                if (low == "z" or k == pygame.K_BACKSPACE) and cwd != folder:
                    cwd, sel = cwd.parent, 0
                elif low == "n":
                    name = ask_line("New file", "Name (ends in .sh or .py)")
                    if name:
                        name = name.replace("/", "-")
                        goto = new = cwd / (name if "." in name or cwd.name == ".context" else name + ".sh")
                        if edit(new):
                            flash = run(new)
                elif here is None:
                    pass
                elif k == pygame.K_RETURN and here.is_dir():
                    cwd, sel = here, 0
                elif k == pygame.K_RETURN and edit(here):
                    flash = run(here)
                elif low == "r" and here.suffix in (".sh", ".py"):
                    flash = run(here)
                elif low == "t" and cwd.name == ".context" and here.is_file():
                    here.rename(here.with_suffix("") if here.suffix == ".off" else here.with_name(here.name + ".off"))
                elif low == "d" and here.is_file():
                    if ask_line(f"Delete {here.name}?", "Type y and Enter to delete") == "y":
                        here.unlink()
            else:  # focus == "chat": the left panel, type the message
                if k in (pygame.K_UP, pygame.K_DOWN, pygame.K_PAGEUP, pygame.K_PAGEDOWN):
                    up = max(0, up + (3 if k in (pygame.K_UP, pygame.K_PAGEUP) else -3))
                elif k == pygame.K_BACKSPACE:
                    typed = typed[:-1]
                elif k == pygame.K_RETURN:
                    if not have:
                        flash = ("No chat model: open the Models screen (Tab)", time.time() + 3)
                    elif typed.strip() and not busy[0]:
                        history.append({"role": "user", "content": typed.strip()})
                        typed, up, busy[0] = "", 0, "loading"
                        stop.clear()
                        shown = here if here and here.parent == folder and here.stat().st_size <= 1500 \
                            and refers(history[-1]["content"], here) else None
                        threading.Thread(target=work, args=(shown,), daemon=True).start()
                elif u and u.isprintable():
                    typed += u

        running = sum(j["proc"].poll() is None for j in jobs)
        code_bar(f"{folder.name} · {views[view]}", have[0] if have else None, busy[0], running)
        if view == MODELS:
            cat = catalog()
            rows = [(m, "in use" if have and m == have[0] else f"{cat[m][1]}MB") for m in have]
            draw_rows(4, W - 8, rows or [("No chat model — get one in Models", "")], msel if have else None)
        elif view == RUNS:
            draw_rows(4, W - 8, [(j["name"], status(j)) for j in jobs] or [("No runs yet", "")], jsel if jobs else None)
        else:  # SPLIT: chat (left) and files (right); the focused panel gets the accent border
            cx, cw, fx, fw = 4, 150, 158, 158
            frows = [(p.name, ("off" if p.suffix == ".off" else "on") if cwd.name == ".context" and p.is_file() else "")
                     for p in files]
            draw_rows(fx, fw, frows or [("(empty)", "")], sel if files else None)
            lines = []
            for m in history:
                color = {"user": SOFT, "note": GREEN}.get(m["role"], TEXT)
                lines += [(l, color) for l in wrap(("> " if m["role"] == "user" else "") + m["content"], cw - 6, True)]
            if busy[0]:
                lines.append((("Loading model" if busy[0] == "loading" else "Kesha is coding")
                              + "." * (int(time.time() * 2) % 4), DIM))
            if not history and not busy[0]:
                lines = [(l, DIM) for l in wrap("Ask Kesha for a script.\nFn+Z / Fn+C switch panels. F1 help.",
                                                cw - 6, True)]
            bubble = (wrap(typed, cw - 12, True) or [""])[-4:]
            bh = len(bubble) * 12 + 7
            by = 166 - bh
            avail = max(1, (by - 20) // 12)
            up = min(up, max(0, len(lines) - avail))
            end = len(lines) - up
            for i, (line, color) in enumerate(lines[max(0, end - avail):end]):
                text(line, cx + 2, 20 + i * 12, FS, color)
            pygame.draw.rect(screen, PANEL, (cx, by, cw, bh), border_radius=6)
            cur = "_" if focus == "chat" and time.time() % 1 < 0.5 else ""
            for i, bl in enumerate(bubble):
                text(bl + (cur if i == len(bubble) - 1 else ""), cx + 5, by + 3 + i * 12, FS,
                     TEXT if focus == "chat" else DIM)
            pygame.draw.rect(screen, ACCENT, (cx - 2, 18, cw + 4, 148) if focus == "chat" else (fx - 2, 18, fw + 4, 148),
                             2, border_radius=6)
        if flash[1] > time.time():
            pygame.draw.rect(screen, BG, (0, 150, W, 16))
            text(flash[0], 6, 152, FS, WARN)
        flip(15)


def code():
    while True:
        CODE_ROOT.mkdir(exist_ok=True)
        folders = sorted(p for p in CODE_ROOT.iterdir() if p.is_dir())
        rows = [("+ New project", "")] + [(p.name, f"{len([f for f in p.iterdir() if f.is_file()])} files") for p in folders]
        i, act = pick("Code · projects", rows, "Enter open   D delete   Esc back", actions="d")
        if i is None:
            return
        if i == 0:
            if act == "d":
                continue
            name = slug(ask_line("New project", "Name of the project") or "", 32)
            if name == "script":  # slug's fallback: nothing usable typed, or cancelled
                continue
            (CODE_ROOT / name / ".context").mkdir(parents=True, exist_ok=True)
            note = CODE_ROOT / name / ".context" / "device.txt"  # editable copy of the device cheat sheet
            if not note.exists():
                note.write_text("Useful commands on this device:\n" + (HERE / "device.txt").read_text())
            session(CODE_ROOT / name)
        elif act == "d":
            p = folders[i - 1]
            if ask_line(f"Delete project {p.name}?", "Type y and Enter — deletes the whole folder") == "y":
                shutil.rmtree(p, ignore_errors=True)
        else:
            session(folders[i - 1])


