shift, ctrl = set(), set()  # modifier keycodes currently held


def init_ui():
    """Set up drawing. On the device the LCD is not a Wayland/KMS output: like the stock apps we render
    off-screen and copy to /dev/fb_lcd (RGB565), and read the keyboard straight from evdev."""
    global pygame, screen, clock, F, FB, FS, FT, FM, fb, fb565, kbd
    on_device = os.path.exists("/dev/fb_lcd") and "SDL_VIDEODRIVER" not in os.environ
    if on_device:
        os.environ["SDL_VIDEODRIVER"] = "dummy"
    import pygame
    pygame.init()
    if on_device:
        import mmap
        pygame.display.set_mode((1, 1))
        screen = pygame.Surface((W, H))
        fb565 = pygame.Surface((W, H), depth=16, masks=(0xF800, 0x07E0, 0x001F, 0))
        fb = mmap.mmap(os.open("/dev/fb_lcd", os.O_RDWR), W * H * 2)
        name = next((p for p in Path("/sys/class/input").glob("input*/name") if p.read_text().strip() == "tca8418c"), None)
        if name:
            kbd = os.open(f"/dev/input/{next(name.parent.glob('event*')).name}", os.O_RDONLY | os.O_NONBLOCK)
    else:  # desktop window for development
        screen = pygame.display.set_mode((W, H))
        pygame.key.set_repeat(400, 60)
    clock = pygame.time.Clock()
    SPECIAL.update({103: pygame.K_UP, 108: pygame.K_DOWN, 105: pygame.K_LEFT, 106: pygame.K_RIGHT,
                    104: pygame.K_PAGEUP, 109: pygame.K_PAGEDOWN, 111: pygame.K_DELETE})

    def font(size, style=""):  # by path: pygame's font lookup shells out to fc-list, which times out on the CM0
        path = f"/usr/share/fonts/truetype/dejavu/DejaVuSans{style}.ttf"
        return pygame.font.Font(path if os.path.exists(path) else None, size)
    F, FS, FB, FT, FM = font(12), font(10), font(12, "-Bold"), font(20, "-Bold"), font(10, "Mono")


def keys():
    """Return the keys pressed since the last call as [(key, unicode)], key being a pygame.K_* value."""
    out = []
    for e in pygame.event.get():
        if e.type == pygame.QUIT:
            raise SystemExit
        if e.type == pygame.KEYDOWN:
            out.append((e.key, e.unicode))
    while kbd is not None:
        try:
            buf = os.read(kbd, 24 * 32)
        except BlockingIOError:
            break
        for off in range(0, len(buf) - 23, 24):  # struct input_event on 64-bit: time(16) type code value
            _, _, kind, code, value = struct.unpack_from("qqHHi", buf, off)
            if kind != 1:
                continue
            if code in (42, 54):
                (shift.add if value else shift.discard)(code)
            elif code in (29, 97):
                (ctrl.add if value else ctrl.discard)(code)
            elif value and ctrl and code in CHARS:  # Ctrl+letter arrives as a control character, as in a terminal
                out.append((ord(CHARS[code][0]), chr(ord(CHARS[code][0]) & 31)))
            elif value and code in SPECIAL:
                out.append((SPECIAL[code], ""))
            elif value and code in CHARS:
                out.append((ord(CHARS[code][0]), CHARS[code][bool(shift)]))
    return out


def flip(fps=20):
    if fb:
        fb565.blit(screen, (0, 0))
        fb.seek(0)
        fb.write(fb565.get_buffer().raw)
    else:
        pygame.display.flip()
    clock.tick(fps)


def step(k, u):
    """-1/+1 for up/down in menus. The keyboard prints arrows on F and X; real arrow codes need Fn held."""
    return {pygame.K_UP: -1, pygame.K_DOWN: 1}.get(k) or {"f": -1, "x": 1}.get(u.lower(), 0)


def text(s, x, y, font=None, color=TEXT, right=False):
    img = (font or F).render(s, True, color)
    screen.blit(img, (x - img.get_width() if right else x, y))
    return img.get_width()


def battery():
    """Charge percent from the battery gauge, or None off-device (e.g. on a dev PC)."""
    try:
        for p in sorted(Path("/sys/class/power_supply").glob("*/capacity")):
            return int(p.read_text().strip())
    except (OSError, ValueError):
        return None


