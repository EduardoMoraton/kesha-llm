def code_bar(title, model, busy="", running=0):
    """Top bar for the Code screens: project/view on the left, current model and battery on the right."""
    screen.fill(BG)
    pygame.draw.rect(screen, PANEL, (0, 0, W, 17))
    pygame.draw.rect(screen, ACCENT, (0, 0, 3, 17))
