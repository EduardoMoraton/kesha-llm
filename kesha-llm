BOOT_CONFIG = "/boot/firmware/config.txt"
# The stock image reserves 128 MB for the GPU, which this device barely uses. Power mode drops it to 16 MB,
# giving ~112 MB back to the models (a 350M model then runs resident, ~5 tok/s) but disabling the camera.
# The original line is kept as a "#kesha-llm ..." comment so turning the setting off restores it exactly.
RAM_ON = (r"grep -q '^gpu_mem=' {f} && sed -i -E 's/^gpu_mem=(.*)$/#kesha-llm gpu_mem=\1\ngpu_mem=16/' {f}"
          r" || printf '\n[all]\n#kesha-llm\ngpu_mem=16\n' >> {f}")
RAM_OFF = r"sed -i -E '/^#kesha-llm/{{n;d}}' {f} && sed -i -E 's/^#kesha-llm (gpu_mem=.+)$/\1/;/^#kesha-llm$/d' {f}"


def extra_ram_on(path=BOOT_CONFIG):
    try:
        return any(line.startswith("#kesha-llm") for line in open(path))
    except OSError:
        return False


def toggle_extra_ram():
    script = (RAM_OFF if extra_ram_on() else RAM_ON).format(f=BOOT_CONFIG)
    password = ""
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode:
        password = ask_line("Admin password", f"Needed to edit {BOOT_CONFIG}", secret=True)
        if password is None:
            return
    r = subprocess.run(["sudo", "-S", "-p", "", "sh", "-c", script], input=password + "\n", capture_output=True, text=True)
    if r.returncode:
        return text_view("Settings", "Could not change the setting.\n\n" + (r.stderr.strip() or "wrong password?"))
    if text_view("Settings", "Done. It takes effect after a restart.\n\nPress Enter to restart the Cardputer now.",
                 "Enter restart  Esc later"):
        subprocess.run(["systemctl", "reboot"])


def settings():
    while True:
        cfg = load_config()
        rows = [("Power mode: big AI, no camera (restart)", "ON" if extra_ram_on() else "OFF"),
                ("Flip camera image", "OFF" if cfg.get("no_flip") else "ON")]
        i, _ = pick("Settings", rows, "Enter change   Esc back")
        if i is None:
            return
        if i == 0:
            toggle_extra_ram()
        else:
            save_config({**cfg, "no_flip": not cfg.get("no_flip")})


