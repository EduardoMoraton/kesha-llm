def stop_server():
    global server, server_key
    proc, server, server_key = server, None, None
    if proc:
        proc.terminate()
        try:
            proc.wait(5)
        except subprocess.TimeoutExpired:
            proc.kill()


atexit.register(stop_server)
for _sig in (signal.SIGTERM, signal.SIGHUP):  # closed by the launcher: exit normally so the cleanups above run
    signal.signal(_sig, lambda *_: sys.exit(0))


def ensure_server(key):
    """Start llama-server with `key` loaded (restarting if another model is up). True when ready."""
    global server, server_key
    if server and server.poll() is None and server_key == key:
        return True
    stop_server()
    port = URL.rsplit(":", 1)[1]
    # a server orphaned by a crashed or killed app would keep ~100 MB and make everything crawl
    subprocess.run(["pkill", "-f", f"llama-server .*--port {port}"], capture_output=True)
    (DATA / "slots").mkdir(parents=True, exist_ok=True)
    cmd = [str(LLAMA / "llama-server"), "-m", str(model_path(key)), "--host", "127.0.0.1", "--port", port,
           "-c", "2048", "-t", "4", "-np", "1", "--cache-ram", "0", "--no-warmup", "--slot-save-path", str(DATA / "slots")]
    try:
        proc = server = subprocess.Popen(cmd, stdout=open(LOG, "w"), stderr=subprocess.STDOUT)
    except OSError:
        return False
    server_key = key
    while proc.poll() is None and server is proc:  # stop_server() from the UI also ends this wait
        try:
            urllib.request.urlopen(URL + "/health", timeout=2)
            return True
        except OSError:
            time.sleep(0.5)
    return False


def slot(action, name):
    """Save or restore the server's processed-prompt state (llama.cpp slot file). True on success.
    Reading the Code examples takes about a minute on the CM0; restoring them from disk takes a second."""
    req = urllib.request.Request(f"{URL}/slots/0?action={action}", json.dumps({"filename": name}).encode(),
                                 {"Content-Type": "application/json"})
    path = DATA / "slots" / name
    try:
        urllib.request.urlopen(req, timeout=120).close()
        ok = path.stat().st_size > 1000  # a starved server has been seen writing a 16-byte, useless file
    except OSError:
        ok = False
    if not ok:
        path.unlink(missing_ok=True)  # never keep a file that cannot be restored
    return ok


def sse_deltas(lines):
    """Yield text pieces from an OpenAI-style streaming response (iterable of bytes lines)."""
    for line in lines:
        line = line.strip()
        if not line.startswith(b"data: ") or line == b"data: [DONE]":
            continue
        choices = json.loads(line[6:]).get("choices") or [{}]
        text = choices[0].get("delta", {}).get("content")
        if text:
            yield text


def stream(messages, stop, max_tokens=300, temperature=0.8):
    """Yield reply pieces from the running server until done or `stop` is set."""
    body = json.dumps({"messages": messages, "stream": True, "max_tokens": max_tokens,
                       "temperature": temperature}).encode()
    req = urllib.request.Request(URL + "/v1/chat/completions", body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=600) as r:
        for text in sse_deltas(r):
            if stop.is_set():
                return
            yield text


def download(key):
    """Fetch a model into MODELS, reporting progress in downloads[key]."""
    # shortcut: no cancel/resume, a failed download restarts from zero; add Range requests if that hurts
    dest = model_path(key)
    part = dest.with_suffix(".part")
    try:
        MODELS.mkdir(parents=True, exist_ok=True)
        with urllib.request.urlopen(CATALOG[key][2], timeout=30) as r, open(part, "wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            if total > shutil.disk_usage(MODELS).free:
                raise OSError("not enough disk space")
            done = 0
            while chunk := r.read(1 << 18):
                f.write(chunk)
                done += len(chunk)
                downloads[key] = (done, total)
        if total and done != total:
            raise OSError("download incomplete")
        part.rename(dest)
        del downloads[key]
    except OSError as e:
        part.unlink(missing_ok=True)
        downloads[key] = str(e)[:40]


# ---------------------------------------------------------------- object detection

def load_detector(np, path):
    """Open an ONNX detector. Understands YOLOX exports ([N, 5+classes]) and YOLOv8-style ones ([4+classes, N]).
    Class names come from a `<model>.txt` next to the file (one per line), else the 80 COCO names."""
    import onnxruntime as ort  # not cv2: Debian's OpenCV takes 15-45 s to import on the CM0
    opts = ort.SessionOptions()
    opts.intra_op_num_threads = 3  # leave a core for the camera and the UI
    sess = ort.InferenceSession(str(path), opts, providers=["CPUExecutionProvider"])
    size, shape = sess.get_inputs()[0].shape[2], sess.get_outputs()[0].shape
    size = size if isinstance(size, int) else 416
    grids, strides = [], []
    for stride in (8, 16, 32):
        n = size // stride
        ys, xs = np.mgrid[0:n, 0:n]
        grids.append(np.stack((xs, ys), -1).reshape(-1, 2))
        strides.append(np.full((n * n, 1), stride))
    names = path.with_suffix(".txt")
    return {"sess": sess, "input": sess.get_inputs()[0].name, "size": size,
            "v8": all(isinstance(d, int) for d in shape[1:3]) and shape[1] < shape[2],
            "grid": np.concatenate(grids), "stride": np.concatenate(strides),
            "names": names.read_text().splitlines() if names.exists() else COCO}


def nms(np, boxes, scores, iou=0.45):
    """Indices of the boxes (x, y, w, h) to keep, dropping lower-scored overlaps."""
    x1, y1, x2, y2 = boxes[:, 0], boxes[:, 1], boxes[:, 0] + boxes[:, 2], boxes[:, 1] + boxes[:, 3]
    area, order, keep = boxes[:, 2] * boxes[:, 3], scores.argsort()[::-1], []
    while order.size:
        i, rest = order[0], order[1:]
        keep.append(i)
        inter = (np.clip(np.minimum(x2[i], x2[rest]) - np.maximum(x1[i], x1[rest]), 0, None)
                 * np.clip(np.minimum(y2[i], y2[rest]) - np.maximum(y1[i], y1[rest]), 0, None))
        order = rest[inter / (area[i] + area[rest] - inter + 1e-9) <= iou]
    return keep


def detect(np, det, frame, threshold=0.4):
    """Run the detector on an RGB frame -> [(label, confidence, x, y, w, h)] in frame pixels."""
    size, (h, w) = det["size"], frame.shape[:2]
    r = min(size / h, size / w)
    nh, nw = int(h * r), int(w * r)
    img = np.full((size, size, 3), 114, np.uint8)  # letterbox with grey padding, nearest-neighbour resize
    img[:nh, :nw] = frame[(np.arange(nh) / r).astype(int)][:, (np.arange(nw) / r).astype(int)]
    chw = img.transpose(2, 0, 1)[None]
    if det["v8"]:   # RGB 0-1 in, boxes already in pixels, no objectness column
        out = det["sess"].run(None, {det["input"]: chw.astype(np.float32) / 255})[0][0].T
        xy, wh, scores = out[:, :2], out[:, 2:4], out[:, 4:]
    else:           # YOLOX: BGR 0-255 in, boxes relative to a grid
        out = det["sess"].run(None, {det["input"]: chw[:, ::-1].astype(np.float32)})[0][0]
        xy, wh = (out[:, :2] + det["grid"]) * det["stride"], np.exp(out[:, 2:4]) * det["stride"]
        scores = out[:, 4:5] * out[:, 5:]
    cls, conf = scores.argmax(1), scores.max(1)
    keep = conf > threshold
    boxes, conf, cls, names = np.hstack((xy - wh / 2, wh))[keep] / r, conf[keep], cls[keep], det["names"]
    return [(names[cls[i]] if cls[i] < len(names) else str(cls[i]), float(conf[i]), *map(int, boxes[i]))
            for i in nms(np, boxes, conf)]


def summary(dets):
    """Group detections by label -> [(label, count, best confidence)], most confident first."""
    best = {}
    for label, conf, *_ in dets:
        n, c = best.get(label, (0, 0))
        best[label] = (n + 1, max(c, conf))
    return sorted(((l, n, c) for l, (n, c) in best.items()), key=lambda t: -t[2])


