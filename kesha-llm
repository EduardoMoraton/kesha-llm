jobs = []  # script runs, newest first: {"name", "proc", "out": [lines]}. They keep running when you leave a screen.
MAX_RUNNING = 3  # each run is a whole sh/python process; more than this and the 512 MB device starts swapping
SYNTAX = re.compile(r"""("(?:\\.|[^"\\])*"?|'(?:\\.|[^'\\])*'?)|(#.*$)|\b(\d+)\b|\b(if|then|else|elif|fi|for|while|do|"""
                    r"""done|case|esac|in|function|return|exit|def|class|import|from|try|except|finally|with|as|and|or|"""
                    r"""not|None|True|False|echo|print)\b""")
SYNTAX_COLORS = ((240, 170, 90), (110, 165, 110), (200, 140, 255), (110, 170, 255))  # string comment number keyword


def paint(line):
    """Split a line of sh/python into [(text, color)] for the editor."""
    # shortcut: a '#' inside ${var#x} or $# is coloured as a comment; needs a real lexer to fix
    out, pos = [], 0
    for m in SYNTAX.finditer(line):
        out += [(line[pos:m.start()], TEXT), (m.group(), SYNTAX_COLORS[m.lastindex - 1])]
        pos = m.end()
    return out + [(line[pos:], TEXT)]


def stems(s):
    return {w.rstrip("s") for w in re.findall(r"[a-z]+", s.lower())} - STOPWORDS


def hints(ask, notes, n=2):
    """The `label: command` lines of the context notes that best match the request, as commented commands.
    The model cannot read files or remember a long list, so we hand it only the few lines it needs."""
    scored = []
    for line in notes.splitlines():
        label, sep, command = line.partition(": ")
        score = sep and len(stems(ask) & stems(label))  # labels only: commands are full of misleading words
        if score:
            scored.append((score, f"# {label}\n{command}"))
    return [h for _, h in sorted(scored, key=lambda t: -t[0])[:n]]


def refers(ask, file):
    """Is the request about this script ("make it loop", "fix count.py")? Only then is the model shown the
    selected file; shown every time, the small models copy it into every new script."""
    return file.suffix in (".sh", ".py") and bool(set(re.findall(r"[\w.-]+", ask.lower()))
                                                 & (EDIT_WORDS | {file.name, file.stem}))


def code_prompt(notes, msgs, last_run="", file=None):
    """Chat messages for the Code model: system line, worked examples, the conversation, then hints + task.
    `file` is the script the user has selected: the model sees it and may answer with its name to change it."""
    *earlier, ask = msgs
    found = hints(ask["content"], notes + "\n" + SKILLS)  # project notes + built-in skills, best matches first
    free = "\n".join(l for l in notes.splitlines() if l.strip() and ": " not in l)[:300]  # plain notes go in whole
    shown = ""
    if file:  # shown the way the model writes scripts itself: a block that starts with the name as a comment
        body = file.read_text().strip()
        body = body if body.startswith(f"# {file.name}") else f"# {file.name}\n{body}"
        shown = f"```{'python' if file.suffix == '.py' else 'sh'}\n{body}\n```\n\n"
    task = ((f"Notes:\n{free}\n\n" if free else "") + (f"Hints:\n" + "\n".join(found) + "\n\n" if found else "")
            + shown + (f"{last_run}\n\n" if last_run else "") + "Task: " + ask["content"])
    shots = [{"role": r, "content": c} for pair in CODE_SHOTS for r, c in zip(("user", "assistant"), pair)]
    return [{"role": "system", "content": CODE_SYSTEM}] + shots + earlier + [{"role": "user", "content": task}]


def extract_scripts(reply):
    """Scripts in a model reply -> [(name or None, extension, code)]: every fenced block (named by its first
    line when that is a comment with a valid script name), or the reply itself if it is bare code."""
    def ext(lang, body):  # tiny models mislabel blocks, so the code decides when it is obviously Python
        python = lang.lower() in ("python", "py", "python3") or re.search(r"^(import |from \w+ import |def |print\()", body, re.M)
        shellish = re.search(r"^(echo |cat |ls |cd |rm |mkdir |cp |mv |touch |for \w+ in .*; do|nmcli |ping |curl |"
                             r"wget |df |free |grep |sudo |apt |vcgencmd |hostname |sort |head |tail |chmod )", body, re.M)
        return ".py" if python and not shellish else ".sh"

    blocks = []
    for m in re.finditer(r"```(\w*)[^\n]*\n(.*?)(?:```|\Z)", reply, re.S):
        title = m.group(2).strip().split("\n")[0].lstrip("# ").strip()
        name = title if SCRIPT_NAME.fullmatch(title) else None
        if m.group(2).strip():
            blocks.append((name, Path(name).suffix if name else ext(*m.groups()), m.group(2).strip() + "\n"))
    first = (reply.split() or [""])[0]
    if not blocks and (first.startswith("#!") or first in ("for", "if", "while", "import", "from", "def")
                       or first.startswith("print(") or shutil.which(first)):
        blocks = [(None, ext("", reply), reply.strip() + "\n")]  # no fence, but it starts like a script
    return blocks


def strip_comments(body):
    """Drop full-line comments the model slipped in (the user wants clean scripts). The file-name marker on
    line 0 and any shebang stay, since those are structure, not chatter. Inline comments are left alone: a '#'
    mid-line may live inside a string or URL."""
    lines = body.splitlines()
    kept = [l for i, l in enumerate(lines) if i == 0 or not l.strip().startswith("#") or l.strip().startswith("#!")]
    return "\n".join(kept).strip() + "\n"


def tools_note(folder):
    """Refresh .context/tools.txt: what is installed, so the model can be told. It starts switched off
    (tools.txt.off) because extra text confuses the smallest models; turn it on with T in the file manager."""
    cmds = ("python3 pip curl wget git ffmpeg ffplay pw-play pw-record rpicam-still ir-ctl nmcli bluetoothctl "
            "gpioget gpioset vcgencmd tesseract jq bc lua5.1 node").split()
    mods = "numpy PIL pygame requests evdev serial smbus2 gpiod picamera2 flask".split()
    note = folder / ".context" / "tools.txt"
    note = note if note.exists() else note.with_name("tools.txt.off")
    note.parent.mkdir(exist_ok=True)
    note.write_text("Installed commands - " + " ".join(c for c in cmds if shutil.which(c)) + "\nPython modules - "
                    + " ".join(m for m in mods if importlib.util.find_spec(m)) + "\n")


def slug(s, limit=24):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:limit].strip("-") or "script"


def launch(path):
    """Start a .sh/.py file in its folder as a background job. Returns the job, or None if too many are running."""
    if sum(j["proc"].poll() is None for j in jobs) >= MAX_RUNNING:
        return None
    cmd = ["python3", "-u", path.name] if path.suffix == ".py" else ["sh", path.name]
    proc = subprocess.Popen(cmd, cwd=path.parent, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, text=True, errors="replace", start_new_session=True)
    job = {"name": path.name, "proc": proc, "out": []}

    def read():
        for line in proc.stdout:
            job["out"].append(line)
            del job["out"][:-500]
        proc.wait()

    threading.Thread(target=read, daemon=True).start()
    jobs.insert(0, job)
    jobs[:] = [j for n, j in enumerate(jobs) if n < 8 or j["proc"].poll() is None]
    return job


def kill(job):
    if job["proc"].poll() is None:
        os.killpg(job["proc"].pid, signal.SIGKILL)  # the whole group: scripts start child processes


atexit.register(lambda: [kill(j) for j in jobs])


def status(job):
    code_ = job["proc"].poll()
    return "running" if code_ is None else "ok" if code_ == 0 else f"exit {code_}"


def console(job):
    """Live output of one run. Esc leaves it running in the background, K kills it."""
    up = 0
    while True:
        for k, u in keys():
            if k == pygame.K_ESCAPE:
                return
            if u.lower() == "k":
                kill(job)
            up = max(0, up - step(k, u) * 3)
        lines = [l for raw in job["out"][-200:] for l in wrap(raw.rstrip("\n"), W - 8, True)] or ["(no output yet)"]
        up = min(up, max(0, len(lines) - 11))
        header(f"{job['name']} · {status(job)}", "K kill  Esc back")
        end = len(lines) - up
        for i, line in enumerate(lines[max(0, end - 11):end]):
            text(line, 4, 20 + i * 12, FS)
        text("F/X scroll   Esc keeps it running in the background", 4, 156, FS, DIM)
        flip(10)


def edit(path):
    """Tiny code editor. Esc saves and closes, Ctrl+R saves and runs (returns True), Ctrl+Q closes without saving."""
    lines = path.read_text(errors="replace").split("\n") if path.exists() else [""]
    cy = cx = top = left = 0
    cw, rows, cols = FM.size("M")[0], 11, (W - 26) // FM.size("M")[0]
    while True:
        for k, u in keys():
            line = lines[cy]
            if k == pygame.K_ESCAPE or u in ("\x12", "\x13"):   # Esc, Ctrl+R, Ctrl+S: all save
                path.write_text("\n".join(lines))
                if u != "\x13":
                    return u == "\x12"
            elif u == "\x11":                                   # Ctrl+Q
                return False
            elif k in (pygame.K_UP, pygame.K_DOWN, pygame.K_PAGEUP, pygame.K_PAGEDOWN):
                jump = {pygame.K_UP: -1, pygame.K_DOWN: 1, pygame.K_PAGEUP: -rows, pygame.K_PAGEDOWN: rows}[k]
                cy = max(0, min(len(lines) - 1, cy + jump))
            elif k == pygame.K_LEFT:
                cx = cx - 1 if cx else cx
            elif k == pygame.K_RIGHT:
                cx += 1
            elif k == pygame.K_RETURN:
                indent = line[:len(line) - len(line.lstrip(" "))] if cx else ""
                lines[cy:cy + 1] = [line[:cx], indent + line[cx:]]
                cy, cx = cy + 1, len(indent)
            elif k == pygame.K_BACKSPACE and cx:
                lines[cy], cx = line[:cx - 1] + line[cx:], cx - 1
            elif k == pygame.K_BACKSPACE and cy:
                cx = len(lines[cy - 1])
                lines[cy - 1:cy + 1] = [lines[cy - 1] + line]
                cy -= 1
            elif k == pygame.K_TAB or (u and u.isprintable()):
                u = "    " if k == pygame.K_TAB else u
                lines[cy], cx = line[:cx] + u + line[cx:], cx + len(u)
            cx = min(cx, len(lines[cy]))
        top = max(cy - rows + 1, min(top, cy))
        left = max(cx - cols + 1, min(left, cx))
        header(path.name, f"{cy + 1}:{cx + 1}")
        screen.set_clip((24, 18, W - 24, rows * 12 + 2))
        for row, n in enumerate(range(top, min(top + rows, len(lines)))):
            x = 26 - left * cw
            for piece, color in paint(lines[n]):
                x += text(piece, x, 20 + row * 12, FM, color) if piece else 0
        if time.time() % 1 < 0.6:
            pygame.draw.rect(screen, ACCENT, (26 + (cx - left) * cw, 20 + (cy - top) * 12, 2, 12))
        screen.set_clip(None)
        for row, n in enumerate(range(top, min(top + rows, len(lines)))):
            text(str(n + 1), 20, 20 + row * 12, FM, DIM, right=True)
        text("Esc save+close   Ctrl+R save+run   Ctrl+Q discard", 4, 156, FS, DIM)
        flip()


def help_modal():
    """A dismissable cheat sheet (F1). Any key closes it."""
    lines = ["Home:  1-5 or F/X/Z/C move, Enter open, Esc back",
             "",
             "In a project:",
             "  Tab         next screen: Files+Chat / Models / Runs",
             "  Fn + Z / C  focus the chat (left) or files (right)",
             "  Chat focus: type, Enter sends, Fn+F/X scrolls",
             "  Files focus: Fn+F/X move, Enter edit, R run,",
             "               N new, D delete, Z up a folder",
