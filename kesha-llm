# Linux keycodes of the built-in keyboard rows: first code -> (plain, shifted) characters
ROWS = {2: ("1234567890-=", "!@#$%^&*()_+"), 16: ("qwertyuiop[]", "QWERTYUIOP{}"),
        30: ("asdfghjkl;'`", 'ASDFGHJKL:"~'), 43: ("\\zxcvbnm,./", "|ZXCVBNM<>?"), 57: (" ", " ")}
CHARS = {first + i: pair for first, (plain, shifted) in ROWS.items() for i, pair in enumerate(zip(plain, shifted))}
SPECIAL = {1: 27, 14: 8, 15: 9, 28: 13, 96: 13}  # esc, backspace, tab, enter -> same values as pygame.K_*
