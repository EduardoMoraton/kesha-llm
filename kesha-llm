def pick(title, rows, hint, actions=""):
    """List menu of (label, detail) rows. Returns (index, "enter" or the action letter), or (None, None) on Esc."""
    sel = 0
    while True:
        for k, u in keys():
            if k == pygame.K_ESCAPE:
                return None, None
            if k == pygame.K_F1:
                help_modal()
                continue
            sel = (sel + step(k, u)) % len(rows)
            if k == pygame.K_RETURN or (u and u.lower() in actions):
                return sel, "enter" if k == pygame.K_RETURN else u.lower()
        header(title, f"{sel + 1}/{len(rows)}")
        draw_rows(4, W - 8, rows, sel)
        text(hint, 6, 155, FS, DIM)
        flip(10)


def ask_line(title, prompt, secret=False):
    """One-line text input (shown as stars if secret). Returns the text, or None if cancelled with Esc."""
    typed = ""
    while True:
        for k, u in keys():
            if k == pygame.K_ESCAPE:
                return None
            if k == pygame.K_RETURN:
                return typed.strip()
            if k == pygame.K_BACKSPACE:
                typed = typed[:-1]
            elif u and u.isprintable():
                typed += u
        header(title, "Enter ok  Esc cancel")
        text(prompt, 6, 30, color=DIM)
        pygame.draw.rect(screen, PANEL, (4, 52, W - 8, 100), border_radius=6)
        for i, line in enumerate(wrap(("*" * len(typed) if secret else typed) + ("_" if time.time() % 1 < 0.5 else ""), W - 20)[-6:]):
            text(line, 10, 56 + i * 15)
        flip()


