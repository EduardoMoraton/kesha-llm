def catalog():
    """Built-in models plus any other .gguf / .onnx file the user copied into the models folder."""
    known = {url.rsplit("/", 1)[1] for _, _, url in CATALOG.values()}
    own = {p.name: (f"Your own {'vision' if p.suffix == '.onnx' else 'chat'} model.", p.stat().st_size >> 20, None)
           for p in sorted(MODELS.glob("*.*")) if p.suffix in (".gguf", ".onnx") and p.name not in known}
    return {**CATALOG, **own}


def model_path(key):
    name = CATALOG[key][2].rsplit("/", 1)[1] if key in CATALOG else key
    return HERE / name if (HERE / name).exists() else MODELS / name  # models shipped with the app live beside it


def is_vision(key):
    return model_path(key).suffix == ".onnx"


def usable(vision):
    """Installed models of one kind, the configured default first."""
    keys_ = [k for k in catalog() if installed(k) and is_vision(k) == vision]
    default = load_config().get("vision" if vision else "model")
    return sorted(keys_, key=lambda k: k != default)


def installed(key):
    return model_path(key).exists()


def load_config():
