@functools.lru_cache(maxsize=512)
def wrap(s, width, small=False):
    """Split text into lines no wider than `width` pixels (breaking long words too)."""
    font, lines = (FS if small else F), []
    for para in s.split("\n"):
        line = ""
        for word in para.split(" "):
            trial = f"{line} {word}" if line else word
            while font.size(trial)[0] > width:
                if line:
                    lines.append(line)
                    line, trial = "", word
                else:  # a single word wider than the screen: cut it
                    n = next(i for i in range(len(trial), 0, -1) if font.size(trial[:i])[0] <= width or i == 1)
                    lines.append(trial[:n])
                    trial = word = trial[n:]
            line = trial
        lines.append(line)
    return lines


def text_view(title, body, hint="Esc back"):
    """Scrollable full-screen text. Returns True if closed with Enter, False with Esc/Backspace."""
    lines, top = wrap(body, W - 12), 0
    while True:
        for k, u in keys():
            if k in (pygame.K_ESCAPE, pygame.K_RETURN, pygame.K_BACKSPACE):
                return k == pygame.K_RETURN
            top += step(k, u)
        top = max(0, min(top, len(lines) - 10))
        header(title, hint)
        for i, line in enumerate(lines[top:top + 10]):
            text(line, 6, 21 + i * 15)
        flip()


def fit(s, font, width):
    """Cut `s` so it is at most `width` pixels wide."""
    while s and font.size(s)[0] > width:
        s = s[:-1]
    return s


