def selftest():
    import tempfile
    events = [b'data: {"choices":[{"delta":{"role":"assistant"}}]}\n', b"\n", b": ping\n",
              b'data: {"choices":[{"delta":{"content":"Ho"}}]}\n', b'data: {"choices":[{"delta":{"content":"la"}}]}\n',
              b'data: {"choices":[],"usage":{}}\n', b"data: [DONE]\n"]
    assert "".join(sse_deltas(events)) == "Hola"
    assert len(COCO) == 80 and COCO[0] == "person" and COCO[9] == "traffic light" and COCO[79] == "toothbrush", COCO
    for key, (desc, mb, url) in CATALOG.items():
        assert url.startswith("https://") and url.endswith((".gguf", ".onnx")) and mb > 0 and desc, key
    assert summary([("cat", .5, 0, 0, 1, 1), ("dog", .9, 0, 0, 1, 1), ("cat", .7, 0, 0, 1, 1)]) == \
        [("dog", 1, .9), ("cat", 2, .7)]
    assert extract_scripts("Sure!\n```sh\necho hi\n```\nand\n```python\n# a.py\nprint(1)\n```") == \
        [(None, ".sh", "echo hi\n"), ("a.py", ".py", "# a.py\nprint(1)\n")]
    assert extract_scripts("```sh\n#bat.sh\ndate") == [("bat.sh", ".sh", "#bat.sh\ndate\n")] and extract_scripts("I cannot") == []
    assert extract_scripts("```sh\n# ../../etc/x.sh\ndate\n```")[0][0] is None          # a path is not a name
    assert extract_scripts("#!/usr/bin/env python3\nprint(1)") == [(None, ".py", "#!/usr/bin/env python3\nprint(1)\n")]
    assert extract_scripts("```sh\nimport os\nprint(os.getcwd())\n```")[0][1] == ".py"  # mislabelled block
    assert extract_scripts("echo hi") == [(None, ".sh", "echo hi\n")]                     # no fence at all
    notes = "battery percent: cat /b\nwifi networks: nmcli w\nKeep answers short"
    assert hints("show the battery percent", notes) == ["# battery percent\ncat /b"] and hints("sing", notes) == []
    prompt = code_prompt(notes, [{"role": "user", "content": "list wifi network"}])
    task = prompt[-1]["content"]
    assert task.startswith("Notes:\nKeep answers short\n\nHints:\n") and task.endswith("\n\nTask: list wifi network"), task
    assert "nmcli w" in task and "nmcli -f SIGNAL,SSID" in task, task  # project note hint + a built-in wifi skill
    assert strip_comments("# a.sh\nls  # inline stays\n# drop this\necho hi\n") == "# a.sh\nls  # inline stays\necho hi\n"
    assert strip_comments("#!/bin/sh\n# note\necho hi\n") == "#!/bin/sh\necho hi\n"  # shebang + first line survive
    assert prompt[0]["role"] == "system" and [m["role"] for m in prompt[1:]] == ["user", "assistant"] * len(CODE_SHOTS) + ["user"]
    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as f:
        f.write("echo a\n")
    shown = code_prompt("", [{"role": "user", "content": "say b"}], file=Path(f.name))[-1]["content"]
    assert shown == f"```sh\n# {Path(f.name).name}\necho a\n```\n\nTask: say b", shown
    assert refers("make it say b", Path(f.name)) and refers(f"fix {Path(f.name).name}", Path(f.name))
    assert not refers("show my ip address", Path(f.name))
    os.unlink(f.name)
    assert [c for s, c in paint('echo "a # b" 42 # note') if s.strip()] == [SYNTAX_COLORS[3], SYNTAX_COLORS[0],
                                                                            SYNTAX_COLORS[2], SYNTAX_COLORS[1]]
    assert "".join(s for s, _ in paint("if x; then y  # z")) == "if x; then y  # z"
    assert slug("Show me the Battery %!") == "show-me-the-battery" and slug("???") == "script"
    # the boot-config toggle must restore the original file byte for byte
    for original in ("a=1\ngpu_mem=128\n[all]\nb=2\n", "a=1\n"):
        with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as f:
            f.write(original)
        assert not extra_ram_on(f.name)
        subprocess.run(["sh", "-c", RAM_ON.format(f=f.name)], check=True)
        on = open(f.name).read()
        assert extra_ram_on(f.name) and "\ngpu_mem=16\n" in on and "gpu_mem=128\n" not in on.replace("#kesha-llm gpu_mem=128", ""), on
        subprocess.run(["sh", "-c", RAM_OFF.format(f=f.name)], check=True)
        off = open(f.name).read()
        assert not extra_ram_on(f.name) and "gpu_mem=16" not in off and off.startswith(original.rstrip("\n")), off
        os.unlink(f.name)
    os.environ["SDL_VIDEODRIVER"] = "dummy"
    init_ui()
    for line in wrap("hello tiny wonderful world " + "x" * 400 + "\nend", 100):
        assert F.size(line)[0] <= 100, line
    assert wrap("a\nb", 100) == ["a", "b"]
    print("selftest ok")


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
    else:
        init_ui()
        home()
