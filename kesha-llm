    flip()
    try:
        import numpy as np
        from picamera2 import Picamera2
        cam = Picamera2()
        # shortcut: 640x480 is enough for boxes but coarse for OCR of small print; use a still mode if needed
        cam.configure(cam.create_preview_configuration(main={"size": (640, 480), "format": "BGR888"}))  # = RGB bytes
        cam.start()
    except Exception as e:  # missing module, camera busy or absent: all end the same way for the user
        return text_view("Vision", f"Camera not available.\n\n{e}")
    have = usable(vision=True)
    shared = {"frame": None, "dets": [], "ms": 0, "run": True, "key": have[0], "error": ""}

    def loop():
        loaded = det = None
        while shared["run"]:
            try:
                if loaded != shared["key"]:
                    loaded, det = shared["key"], None
                    det = load_detector(np, model_path(loaded))
                    shared["error"] = ""
                if det is None or shared["frame"] is None:
                    time.sleep(0.1)
                    continue
                t = time.time()
                shared["dets"] = detect(np, det, shared["frame"])
                shared["ms"] = int((time.time() - t) * 1000)
            except Exception as e:  # a model file this code cannot read must not kill the camera view
                det, shared["dets"], shared["error"] = None, [], f"model error: {e}"[:48]

    threading.Thread(target=loop, daemon=True).start()
    mode, rec, log, rec_start, last_write, flash = 0, None, None, 0, 0, ("", 0)

    def stop_rec():
        log.close()
        try:
            rec.stdin.close()
            rec.wait(10)
        except (OSError, subprocess.TimeoutExpired):
            rec.kill()

    try:
        while True:
            big = cam.capture_array()
